# Bu dosyayı kopyalayıp .env yapın: cp .env.example .env
# .env dosyasını ASLA git'e commit etmeyin.

POSTGRES_DB=courier_tracking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

REDIS_PORT=6379

APP_PORT=8080

# openssl rand -base64 32 ile üretin
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
JWT_EXPIRATION=86400000

# Windows'ta 61613 Hyper-V ile çakışırsa host portunu değiştirin (container içi 61613 kalır)
RABBITMQ_STOMP_PORT=61613
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=courier
RABBITMQ_PASSWORD=courier
